# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# Twilio Console > Account Info. The auth token verifies webhook signatures,
# signs media-stream tokens, and lets us redirect a call to a fallback message.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token

# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# The public HTTPS URL Twilio uses to reach this server (your ngrok URL locally).
# No trailing slash. Must match exactly what you paste into the Twilio console.
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# ---------------------------------------------------------------------------
# Optional (defaults shown)
# ---------------------------------------------------------------------------

# PORT=5050
# HOST=0.0.0.0
# NODE_ENV=development          # "production" = JSON logs instead of pretty logs
# LOG_LEVEL=info                # trace | debug | info | warn | error

# Reject webhooks that fail X-Twilio-Signature validation. Leave on.
# TWILIO_VALIDATE_SIGNATURE=true

# OPENAI_REALTIME_MODEL=gpt-realtime
# OPENAI_REALTIME_URL=wss://api.openai.com/v1/realtime
# OPENAI_VOICE=marin            # e.g. marin, cedar, alloy, ash, coral, sage, verse
# OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe   # empty = no caller transcripts in logs
# OPENAI_VAD_THRESHOLD=0.5      # raise (e.g. 0.7) for noisy lines
# OPENAI_VAD_SILENCE_MS=500     # silence before the AI considers the caller done
# OPENAI_VAD_PREFIX_PADDING_MS=300
# OPENAI_CONNECT_TIMEOUT_MS=10000

# Who the screener answers for, used in the system prompt.
# SCREENER_OWNER_NAME=Alex Smith
# MAX_CALL_DURATION_SECONDS=600
# FALLBACK_MESSAGE=Sorry, we're having technical difficulties right now. Please try again later. Goodbye.

# How long in-flight calls may continue after SIGTERM before being ended.
# SHUTDOWN_GRACE_MS=25000
