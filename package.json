{
  "name": "voice-screener",
  "version": "1.0.0",
  "description": "Inbound call screener that bridges Twilio Media Streams to the OpenAI Realtime API",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "pino": "^10.0.0",
    "twilio": "^5.10.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.0",
    "@types/ws": "^8.18.1",
    "pino-pretty": "^13.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
